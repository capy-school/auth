---
import { auth } from '../../lib/auth';
import { localAuthPolicy } from '../../lib/local-runtime';
import AccountPage from '../../components/account/AccountPage.astro';
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session?.user) return Astro.redirect('/');
---
<AccountPage page="passkey" user={session.user} passkeysAvailable={!localAuthPolicy} />
