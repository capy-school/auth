  code: ['m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16'],
  building: ['M6 21V3h12v18M10 21v-4h4v4M9 7h1m4 0h1m-6 4h1m4 0h1M3 21h18'],
  note: ['M14 3H5v18h14V8l-5-5Z', 'M14 3v5h5M8 12h8m-8 4h5'],
