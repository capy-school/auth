!docker/launcher/
!docker/launcher/Cargo.toml
!docker/launcher/Cargo.lock
!docker/launcher/src/
!docker/launcher/src/**
# This file is copied ONLY by the test-api target, never by tiny/runtime.
!tests/
!tests/fixtures/
!tests/fixtures/static-api.py

# Defence in depth, including secrets nested in otherwise allowed directories.
**/.env*
**/.dev.vars*
**/.npmrc
**/.yarnrc*
**/.git
**/.git/**
**/.codegraph/**
**/node_modules/**
**/target/**
**/*.db*
**/*.sqlite*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/__pycache__/**
src/kit/diagnostic-routes/**
src/kit/diagnostic-routes/
server/**
server-rust/**
.svelte-kit/**
dist/**
