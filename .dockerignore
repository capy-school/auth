# Start closed. Only the static frontend and independent runtime enter context.
**
!Dockerfile
!.dockerignore
!package.json
!bun.lock
!svelte.config.js
!vite.sveltekit.config.ts
!tsconfig.json
!tsconfig.sveltekit.json
!public/
!public/**
public/.assetsignore
!src/
!src/kit/
!src/kit/**
!src/styles/
!src/styles/**
!src/components/
!src/components/account/
!src/components/account/**
!src/lib/
!src/lib/auth-client.ts
!src/lib/apps.ts
!src/lib/local-policy.mjs
!src/lib/local-client.ts
!src/lib/local-inbox.mjs
!src/lib/dashboard-notes.ts
