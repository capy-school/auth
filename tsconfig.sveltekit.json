{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src/kit/**/*.ts",
    "src/kit/**/*.svelte",
    ".svelte-kit/*.d.ts",
    ".svelte-kit/types/**/$types.d.ts"
  ]
}
