{
  "name": "auth",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["api"],
  "scripts": {
    "dev": "PUBLIC_KIT_AUTH_LOCAL_MODE=1 PORTLESS_HTTPS=0 portless auth vite",
    "dev:api": "npm run api:dev",
    "dev:setup": "tsx scripts/setup-local.ts",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "test": "node --import tsx --test --test-concurrency=1 tests/frontend-layout.test.mjs tests/kit-config.test.mjs tests/kit-app-*.test.* tests/account-auth.test.ts tests/account-browser.test.mjs tests/dashboard-browser.test.mjs tests/local-*.test.*",
    "test:unit": "node --import tsx --test --test-concurrency=1 tests/frontend-layout.test.mjs tests/kit-config.test.mjs tests/kit-app-auth.test.ts tests/kit-app-build.test.mjs tests/kit-app-proxy.test.mjs tests/kit-app-redirect.test.mjs tests/kit-app-login.test.mjs",
    "test:local": "node --import tsx --test tests/local-*.test.*",
    "kit:dev": "vite",
    "kit:dev:local": "npm run dev",
    "kit:check": "npm run check",
    "kit:build": "npm run build",
    "kit:test": "node --test tests/kit-config.test.mjs",
    "test:kit:app": "node --import tsx --test --test-concurrency=1 tests/kit-app-*.test.*",
    "api:dev": "npm run --workspace @capy/auth-api dev",
    "api:build": "npm run --workspace @capy/auth-api build",
    "api:preview": "npm run --workspace @capy/auth-api preview",
    "api:cf:types": "npm run --workspace @capy/auth-api cf:types",
    "api:deploy": "npm run --workspace @capy/auth-api deploy",
    "image:build": "docker build --target tiny -t auth-static:local .",
    "preimage:test": "docker build --target test-api -t auth-static:test-api .",
    "image:test": "AUTH_STATIC_IMAGE=auth-static:local AUTH_STATIC_FIXTURE=0 node --test --test-concurrency=1 tests/static-image*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.17",
    "better-auth": "1.3.34",
    "qrcode": "1.5.4",
    "tailwindcss": "4.1.17"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/qrcode": "1.5.6",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
